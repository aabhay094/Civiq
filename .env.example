# Copy this file to `.env` (same folder as manage.py) and fill in real values.
# `.env` is git-ignored — it will NEVER be committed or shared accidentally.

# --- Gmail SMTP (for auto-emailing grievances to departments) ---
CIVIQ_GMAIL_USER=yourteam@gmail.com
CIVIQ_GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- AI Camera (image analysis for /report/) ---
# Leave blank to run in fallback/demo mode — the AI Camera flow still works,
# it just won't auto-detect the category (citizen picks manually).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Django core settings (only needed for production; safe defaults used locally) ---
# DJANGO_SECRET_KEY=replace-with-a-long-random-string
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=civiq.onrender.com
